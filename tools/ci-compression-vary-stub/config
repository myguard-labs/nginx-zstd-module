# CI-only stub module that registers under the exact name
# "ngx_http_compression_vary_filter_module" (HanadaLee's Vary-flattening
# filter) and does nothing else. The gzip_vary-off config-load warnings
# are suppressed when a module by that name is loaded — see
# ngx_http_zstd_vary_handled_externally() in ngx_http_zstd_common.h —
# and the CI witness loads this stub to assert the warnings go quiet,
# then omits it to assert they still fire. Never ship or install this
# module: it claims a real third-party module's name.

ngx_addon_name=ngx_http_compression_vary_filter_module
ngx_module_type=HTTP
ngx_module_name=ngx_http_compression_vary_filter_module
ngx_module_incs=
ngx_module_deps=
ngx_module_srcs="$ngx_addon_dir/ngx_http_compression_vary_filter_module.c"
ngx_module_libs=
ngx_module_order=

. auto/module
